const base = import.meta.env.BASE_URL;

const toc = [
  { label: 'Scheduling Order',   id: 'order' },
  { label: 'GPU Placement',      id: 'placement' },
  { label: 'Preemption',         id: 'preemption' },
  { label: 'Priority Score',     id: 'score' },
  { label: 'Billing & Usage',    id: 'billing' },
  { label: 'Fair-Share',         id: 'fairshare' },
