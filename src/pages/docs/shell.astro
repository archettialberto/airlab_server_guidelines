import CodeBlock from '../../components/CodeBlock.astro';
import OsCodeBlock from '../../components/OsCodeBlock.astro';

const base = import.meta.env.BASE_URL;

const toc = [
  { label: 'SSH Keys',              id: 'ssh-keys' },
  { label: 'SSH Config & Alias',    id: 'ssh' },
  { label: 'VS Code & GitHub',      id: 'vscode' },
  { label: 'Transferring Files',    id: 'transfer' },
  { label: 'Navigation & Files',    id: 'navigation' },
  { label: 'Tmux',                  id: 'tmux' },
