---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const base = import.meta.env.BASE_URL;

const toc = [
  { label: 'Slurm in a Nutshell',   id: 'concepts' },
  { label: 'Choosing a Queue',      id: 'queues' },
  { label: 'Interactive Jobs',      id: 'interactive' },
  { label: 'Batch Jobs',            id: 'batch' },
  { label: 'GPU Jobs',              id: 'gpu' },
  { label: 'Long Jobs on bulk',     id: 'bulk' },
  { label: 'Job Notifications',     id: 'notifications' },
  { label: 'Essential Commands',    id: 'commands' },
  { label: 'Troubleshooting',       id: 'troubleshooting' },
];

// Decision flow: first matching row wins
const flow = [
  { icon: '🧪', q: 'Testing, debugging, or a short interactive session?', p: 'debug' },
  { icon: '🖥️', q: 'No GPU needed (preprocessing, analysis, Conda)?',   p: 'cpu' },
  { icon: '🐢', q: 'Long or not urgent, and able to resume from a checkpoint?', p: 'bulk' },
  { icon: '🚀', q: 'Everything else: standard training and evaluation runs', p: 'normal' },
];

// Queue cards. prio = scheduling tier (4 = considered first)
const queues = [
  { name: 'debug',  icon: '🧪', use: 'Tests & debugging',          prio: 4, time: '2 h PhD · 1 h MSc/Ext', gpus: '1',                    cost: 'low',  interactive: true,  preempt: false },
  { name: 'normal', icon: '🚀', use: 'Standard production',        prio: 3, time: '24 h',                  gpus: 'PhD 3 · MSc 1 · Ext 3', cost: 'high', interactive: false, preempt: false },
  { name: 'cpu',    icon: '🖥️', use: 'CPU-only work',              prio: 2, time: '5 d PhD · 24 h MSc/Ext', gpus: 'none',                cost: 'CPU only', interactive: true,  preempt: false },
  { name: 'bulk',   icon: '🐢', use: 'Long, restartable jobs',     prio: 1, time: '5 days',                gpus: '8',                     cost: 'low',  interactive: false, preempt: true  },
];

// Fair-share cost per GPU-hour (generic + type billing weight), normal vs debug/bulk
const gpuCost = [
  { gpu: 'L4',                    normal: 25, low: 20 },
  { gpu: 'Quadro RTX 6000',       normal: 25, low: 20 },
  { gpu: 'RTX A6000',             normal: 35, low: 28 },
  { gpu: 'RTX PRO 6000 Blackwell', normal: 60, low: 48 },
];

const rules = [
  { icon: '⏱️', t: 'Realistic run time',   d: 'Short jobs slip into free gaps (backfilling) and start sooner.' },
  { icon: '📏', t: 'Only what you use',  d: 'Allocated CPUs and GPUs count against your fair-share, even when idle.' },
  { icon: '🎯', t: 'Smallest GPU that fits', d: 'A PRO 6000 costs 2.4× the fair-share of an L4.' },
  { icon: '⚖️', t: 'Per GPU, at most',   d: '16 CPUs and 48 GB of RAM.' },
  { icon: '💾', t: 'Checkpoint bulk jobs', d: 'They can be preempted and restart from the beginning.' },
  { icon: '🔄', t: 'Usage fades',        d: 'Recorded usage halves every 7 days.' },
];
---

<DocsLayout title="Running Jobs (Slurm)" toc={toc}>

  <h1>Running Jobs (Slurm)</h1>

  <p>
    Every workload on polimi-cluster runs as a <strong>Slurm job</strong>: you declare the resources
    you need, Slurm queues the request and starts the job on a compute node when they are free.
  </p>

  <!-- ── Concepts ──────────────────────────────────────────────────────────── -->
  <h2 id="concepts">Slurm in a Nutshell</h2>

  <table>
    <thead>
      <tr><th>You declare</th><th>Option</th><th>Note</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>Queue</strong> (partition)</td><td class="whitespace-nowrap"><code>--partition=normal</code></td><td>See <a href="#queues">Choosing a Queue</a></td></tr>
      <tr><td><strong>Max runtime</strong></td><td class="whitespace-nowrap"><code>--time=04:00:00</code></td><td>The job is stopped when it runs out</td></tr>
      <tr><td><strong>CPUs</strong></td><td class="whitespace-nowrap"><code>--cpus-per-task=8</code></td><td></td></tr>
      <tr><td><strong>Memory</strong></td><td class="whitespace-nowrap"><code>--mem=32G</code></td><td>Exceed it and the job is killed</td></tr>
      <tr><td><strong>GPUs</strong></td><td class="whitespace-nowrap"><code>--gres=gpu:1</code></td><td>See <a href="#gpu">GPU Jobs</a></td></tr>
    </tbody>
  </table>

  <!-- ── Queues ────────────────────────────────────────────────────────────── -->
  <h2 id="queues">Choosing a Queue</h2>

  <h3>First match wins</h3>

  <div class="not-prose my-5 space-y-2">
    {flow.map((f, i) => (
      <div class="flex items-center gap-3 rounded-lg border border-gray-200 px-4 py-3">
        <span class="text-xl w-7 text-center flex-shrink-0" aria-hidden="true">{f.icon}</span>
        <span class="flex-1 text-sm text-gray-700">{f.q}</span>
        <span class="text-gray-300 flex-shrink-0" aria-hidden="true">→</span>
        <code class="flex-shrink-0 w-16 text-center text-sm font-mono font-bold rounded px-2 py-1 bg-accent-800 text-white">{f.p}</code>
      </div>
    ))}
  </div>

  <h3>The four queues at a glance</h3>

  <div class="not-prose my-5 grid sm:grid-cols-2 gap-4">
    {queues.map((q) => (
      <div class="rounded-xl border border-gray-200 overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-2.5 bg-accent-50 border-b border-gray-200">
          <span class="text-lg" aria-hidden="true">{q.icon}</span>
          <code class="font-mono font-bold text-accent-800">{q.name}</code>
          <span class="ml-auto text-xs text-gray-500">{q.use}</span>
        </div>
        <div class="grid grid-cols-[auto,1fr] gap-x-4 gap-y-1.5 px-4 py-3 text-sm text-gray-700">
          <span class="text-gray-400">Priority</span>
          <span class="flex items-center gap-1" aria-label={`${q.prio} of 4`}>
            {[1, 2, 3, 4].map((n) => (
              <span class:list={['inline-block w-4 h-2 rounded-sm', n <= q.prio ? 'bg-accent-800' : 'bg-gray-200']}></span>
            ))}
          </span>
          <span class="text-gray-400">Max time</span><span>{q.time}</span>
          <span class="text-gray-400">GPUs at once</span><span>{q.gpus}</span>
          <span class="text-gray-400">Fair-share cost</span>
          <span>{q.cost === 'high' ? '▲ higher' : q.cost === 'low' ? '▼ lower' : q.cost}</span>
          <span class="text-gray-400">Interactive</span><span>{q.interactive ? '✓' : '✗ batch only'}</span>
          <span class="text-gray-400">Preemptible</span>
          <span>{q.preempt ? <strong class="text-yellow-700">⚠ yes, checkpoint!</strong> : 'no'}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="callout callout-success">
    <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-green-500" fill="none" stroke="currentColor"
         stroke-width="2" viewBox="0 0 24 24">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
    <div class="text-sm leading-relaxed">
      <strong>Use <code>debug</code> for tests.</strong> It has the highest priority and costs less
      fair-share than <code>normal</code>.
    </div>
  </div>

  <h3>How your priority works</h3>

  <div class="not-prose my-5 flex flex-col sm:flex-row sm:items-center gap-2 text-sm">
    {['🧾 Resources × time × queue', '📈 Usage ↑', '⚖️ Fair-share ↓', '⏳ Next jobs wait longer'].map((step, i) => (
      <>
        {i > 0 && (
          <span class="text-gray-300 text-center" aria-hidden="true">
            <span class="sm:hidden">↓</span><span class="hidden sm:inline">→</span>
          </span>
        )}
        <span class="rounded-lg border border-gray-200 px-3 py-2 whitespace-nowrap">{step}</span>
      </>
    ))}
  </div>

  <ul>
    <li>Slurm considers queues in order: <code>debug</code> ▸ <code>normal</code> ▸ <code>cpu</code> ▸ <code>bulk</code>.</li>
    <li>Within a queue, jobs are ranked by a <strong>score</strong>: your account type, your <strong>fair-share</strong>, and how long the job has waited.</li>
    <li>Fair-share drops as you use the cluster and recovers over time. Usage is accounting only, not money.</li>
  </ul>

  <h3>Rules of thumb</h3>

  <div class="not-prose my-5 grid sm:grid-cols-2 gap-3">
    {rules.map((r) => (
      <div class="flex gap-3 rounded-lg border border-gray-200 px-4 py-3">
        <span class="text-xl flex-shrink-0" aria-hidden="true">{r.icon}</span>
        <div class="text-sm">
          <div class="font-semibold text-gray-900">{r.t}</div>
          <div class="text-gray-600">{r.d}</div>
        </div>
      </div>
    ))}
  </div>

  <p>
    Exact formulas, weights, and per-account limits are in
    <a href={`${base}docs/scheduling`}>Scheduling Policy</a>.
  </p>

  <!-- ── Interactive ──────────────────────────────────────────────────────── -->
  <h2 id="interactive">Interactive Jobs</h2>

  <p>
    An interactive allocation gives you a shell on a compute node, for testing and debugging.
    It is allowed on <code>debug</code> and <code>cpu</code> only.
  </p>

  <CodeBlock
    lang="bash"
    filename="polimi-cluster"
    code={`srun --partition=debug --time=00:10:00 --cpus-per-task=1 --mem=2G --pty bash

hostname; nproc; free -h    # you are now on a compute node
exit                        # release the allocation as soon as you are done`}
  />

  <p>
    The session dies if your SSH connection drops: run it inside <a href={`${base}docs/shell#tmux`}>tmux</a>
    if needed. An idle allocation still blocks its resources.
  </p>

  <!-- ── Batch ────────────────────────────────────────────────────────────── -->
  <h2 id="batch">Batch Jobs</h2>

  <p>
    Real work runs as batch jobs: a script whose <code>#SBATCH</code> lines declare the resources.
    It keeps running after you log out.
  </p>

  <CodeBlock
    lang="bash"
    filename="hello.sbatch"
    code={`#!/bin/bash
#SBATCH --job-name=hello
#SBATCH --partition=debug
#SBATCH --time=00:05:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --output=hello-%j.out    # %j = job ID
#SBATCH --error=hello-%j.err

hostname
date`}
  />

  <CodeBlock
    lang="bash"
    filename="polimi-cluster"
    code={`sbatch hello.sbatch     # prints: Submitted batch job JOBID
squeue --me             # check its status
cat hello-JOBID.out     # read the output when it is done`}
  />

  <p>
    For CPU-only work, use <code>--partition=cpu</code> and no <code>--gres</code>. Start small,
    check the actual usage with <code>sacct</code>, then adjust.
  </p>

  <!-- ── GPU ──────────────────────────────────────────────────────────────── -->
  <h2 id="gpu">GPU Jobs</h2>

  <p>
    Request GPUs with <code>--gres=gpu:N</code>: Slurm assigns them and makes only those visible to
    your job. Never set <code>CUDA_VISIBLE_DEVICES</code> yourself.
  </p>

  <CodeBlock
    lang="bash"
    filename="gpu-train.sbatch"
    code={`#!/bin/bash
#SBATCH --job-name=gpu-train
#SBATCH --partition=normal
#SBATCH --time=08:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gres=gpu:1
#SBATCH --output=gpu-train-%j.out
#SBATCH --error=gpu-train-%j.err

module load miniconda/25.5.1
conda activate my-project      # see Software & Conda

nvidia-smi                     # logs which GPU the job received
python train.py`}
  />

  <p>
    To ask for a specific GPU model, add its type: <code>--gres=gpu:TYPE:1</code>. List the
    available types with:
  </p>

  <CodeBlock
    lang="bash"
    filename="polimi-cluster"
    code={`sinfo -o "%15N %G"     # node name and its GPU types, e.g. gpu:quadro_rtx_6000:8`}
  />

  <p>
    With several GPUs (<code>--gres=gpu:2</code>), check that your code really uses them all,
    e.g. <code>torch.cuda.device_count()</code>.
  </p>

  <!-- ── Bulk ─────────────────────────────────────────────────────────────── -->
  <h2 id="bulk">Long Jobs on bulk</h2>

  <p>
    A <code>bulk</code> job can be <strong>preempted</strong> by <code>debug</code> or
    <code>normal</code> jobs: it is stopped, put back in the queue, and later restarted
    <strong>from the beginning of the script</strong>. Your code must save checkpoints and resume from the latest one.
  </p>

  <CodeBlock
    lang="bash"
    filename="long-train.sbatch"
    code={`#!/bin/bash
#SBATCH --job-name=long-train
#SBATCH --partition=bulk
#SBATCH --time=3-00:00:00         # 3 days
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --output=long-train-%j.out

module load miniconda/25.5.1
conda activate my-project

# train.py must load checkpoints/last.pt when it exists
python train.py --resume checkpoints/last.pt`}
  />

  <!-- ── Notifications ────────────────────────────────────────────────────── -->
  <h2 id="notifications">Job Notifications</h2>

  <p>
    Slurm can notify you when your job ends or fails. Add two lines to your script, choosing
    where the notification goes:
  </p>

  <CodeBlock
    lang="bash"
    filename="Discord direct message"
    code={`#SBATCH --mail-user=discord     # write "discord" literally
#SBATCH --mail-type=END,FAIL`}
  />

  <CodeBlock
    lang="bash"
    filename="Email"
    code={`#SBATCH --mail-user=name.surname@polimi.it
#SBATCH --mail-type=END,FAIL`}
  />

  <p>
    With <code>discord</code>, you do not need to enter your Discord ID: the cluster already knows it
    from your enrollment and sends the message to you.
  </p>

  <table>
    <thead>
      <tr><th><code>--mail-type</code></th><th>You are notified when…</th></tr>
    </thead>
    <tbody>
      <tr><td><code>BEGIN</code> / <code>END</code> / <code>FAIL</code></td><td>the job starts / finishes / fails</td></tr>
      <tr><td><code>REQUEUE</code></td><td>the job is requeued (e.g., after preemption on <code>bulk</code>)</td></tr>
      <tr><td><code>TIME_LIMIT_80</code></td><td>the job reaches 80% of its time limit (also <code>_50</code>, <code>_90</code>)</td></tr>
      <tr><td><code>ALL</code></td><td>all of the above events</td></tr>
    </tbody>
  </table>

  <!-- ── Commands ─────────────────────────────────────────────────────────── -->
  <h2 id="commands">Essential Commands</h2>

  <table>
    <thead>
      <tr><th>Command</th><th>What it does</th></tr>
    </thead>
    <tbody>
      <tr><td><code>sinfo</code></td><td>Nodes and queues, and their state</td></tr>
      <tr><td><code>squeue --me</code></td><td>Your queued and running jobs</td></tr>
      <tr><td><code>sbatch script.sbatch</code></td><td>Submit a batch job</td></tr>
      <tr><td><code>scancel JOBID</code></td><td>Cancel a job</td></tr>
      <tr><td><code>scontrol show job JOBID</code></td><td>Full details of a job</td></tr>
      <tr><td><code>sacct -j JOBID</code></td><td>Review a finished job</td></tr>
      <tr><td><code>sprio -l -u $USER</code></td><td>Why your pending jobs have their priority</td></tr>
    </tbody>
  </table>

  <CodeBlock
    lang="bash"
    filename="polimi-cluster"
    code={`# How much of the requested resources a finished job actually used
sacct -j JOBID --format=JobID,JobName,State,Elapsed,AllocCPUS,ReqMem,ExitCode`}
  />

  <!-- ── Troubleshooting ──────────────────────────────────────────────────── -->
  <h2 id="troubleshooting">Troubleshooting</h2>

  <table>
    <thead>
      <tr><th>Problem</th><th>First checks</th></tr>
    </thead>
    <tbody>
      <tr><td>Job is pending</td><td><code>squeue --me</code>: read the <code>REASON</code> column. Check queue, limits, and requested resources.</td></tr>
      <tr><td>Job disappeared or failed</td><td>Read the <code>*.err</code> / <code>*.out</code> files and run <code>sacct -j JOBID</code>.</td></tr>
      <tr><td>Out of memory</td><td>Request more <code>--mem</code>, or reduce the program's memory use.</td></tr>
      <tr><td><code>bulk</code> job started over</td><td>It was preempted: resume from a checkpoint (<a href="#bulk">see above</a>).</td></tr>
      <tr><td>No GPU visible</td><td>Check <code>#SBATCH --gres=gpu:N</code> and run <code>nvidia-smi</code> inside the job.</td></tr>
      <tr><td>Works on the login node, not in a job</td><td>Load the same modules and Conda environment in the script.</td></tr>
      <tr><td>Cannot connect through VPN</td><td>Use <code>10.75.4.86</code> instead of the hostname.</td></tr>
    </tbody>
  </table>

  <p>
    Still stuck? See <a href={`${base}docs/welcome#help`}>Getting Help</a>.
  </p>

</DocsLayout>
