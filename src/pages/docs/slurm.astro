const base = import.meta.env.BASE_URL;

const toc = [
  { label: 'Slurm Concepts',        id: 'concepts' },
  { label: 'Partitions & QoS',      id: 'partitions' },
  { label: 'Essential Commands',    id: 'commands' },
  { label: 'Interactive Jobs',      id: 'interactive' },
  { label: 'Batch Jobs',            id: 'batch' },
  { label: 'CPU Jobs',              id: 'cpu' },
